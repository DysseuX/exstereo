    <string name="audio_ambience_width" formatted="false">"Ширина окружения"</string>
    <string name="audio_ambience_level" formatted="false">"Уровень окружения"</string>
    <string name="audio_ambience_description" formatted="false">"Направленная часть сохраняется; расширяется оценка рассеянного окружения. В плотном миксе разделение может быть неточным."</string>
    <string name="audio_side_level" formatted="false">"Уровень синтезированного Side"</string>
    <string name="audio_side_highpass" formatted="false">"Нижняя граница синтеза Side"</string>
    <string name="audio_side_description" formatted="false">"Новая боковая составляющая добавляется к исходной. Более высокая нижняя граница сохраняет бас в центре."</string>
    <string name="audio_shuffler_amount" formatted="false">"Сила Shuffler"</string>
